<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ackermann_bot">
    <pose>0 0 0.15 0 0 0</pose>

    <!--CHASSIS  —  deep metallic blue body-->
    <link name="chassis">
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.9</iyy><iyz>0</iyz>
          <izz>1.0</izz>
        </inertia>
      </inertial>

      <visual name="chassis_vis">
        <geometry><box><size>0.9 0.4 0.1</size></box></geometry>
        <material>
          <ambient>0.05 0.15 0.55 1</ambient>
          <diffuse>0.08 0.22 0.75 1</diffuse>
          <specular>0.4 0.4 0.6 1</specular>
        </material>
      </visual>

      <visual name="cabin_vis">
        <pose>-0.05 0 0.1 0 0 0</pose>
        <geometry><box><size>0.45 0.35 0.12</size></box></geometry>
        <material>
          <ambient>0.04 0.12 0.45 1</ambient>
          <diffuse>0.06 0.18 0.60 1</diffuse>
          <specular>0.5 0.5 0.7 1</specular>
        </material>
      </visual>

      <visual name="bumper_vis">
        <pose>0.46 0 -0.02 0 0 0</pose>
        <geometry><box><size>0.02 0.38 0.06</size></box></geometry>
        <material>
          <ambient>0.7 0.05 0.05 1</ambient>
          <diffuse>0.9 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <visual name="headlight_l">
        <pose>0.46 0.12 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.08 0.04</size></box></geometry>
        <material>
          <ambient>1.0 1.0 0.85 1</ambient>
          <diffuse>1.0 1.0 0.85 1</diffuse>
          <emissive>0.8 0.8 0.5 1</emissive>
        </material>
      </visual>

      <visual name="headlight_r">
        <pose>0.46 -0.12 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.08 0.04</size></box></geometry>
        <material>
          <ambient>1.0 1.0 0.85 1</ambient>
          <diffuse>1.0 1.0 0.85 1</diffuse>
          <emissive>0.8 0.8 0.5 1</emissive>
        </material>
      </visual>

      <visual name="brake_l">
        <pose>-0.46 0.14 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.07 0.03</size></box></geometry>
        <material>
          <ambient>0.9 0.02 0.02 1</ambient>
          <diffuse>0.9 0.02 0.02 1</diffuse>
          <emissive>0.6 0.0 0.0 1</emissive>
        </material>
      </visual>

      <visual name="brake_r">
        <pose>-0.46 -0.14 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.07 0.03</size></box></geometry>
        <material>
          <ambient>0.9 0.02 0.02 1</ambient>
          <diffuse>0.9 0.02 0.02 1</diffuse>
          <emissive>0.6 0.0 0.0 1</emissive>
        </material>
      </visual>

      <collision name="chassis_col">
        <geometry><box><size>0.9 0.4 0.1</size></box></geometry>
      </collision>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <ignition_frame_id>chassis</ignition_frame_id>
      </sensor>
    </link>

    <!--REAR-LEFT WHEEL-->
    <link name="rear_left_wheel">
      <pose>-0.35 0.225 0 -1.5707 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
      </inertial>
      <visual name="tyre">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rim">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.75 1</ambient>
          <diffuse>0.8 0.8 0.85 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!--REAR-RIGHT WHEEL-->
    <link name="rear_right_wheel">
      <pose>-0.35 -0.225 0 -1.5707 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
      </inertial>
      <visual name="tyre">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rim">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.75 1</ambient>
          <diffuse>0.8 0.8 0.85 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- FRONT-LEFT STEER + WHEEL-->
    <link name="front_left_steer_link">
      <pose>0.35 0.225 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent><child>front_left_steer_link</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper></limit>
      </axis>
    </joint>

    <link name="front_left_wheel">
      <pose>0.35 0.225 0 -1.5707 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
      </inertial>
      <visual name="tyre">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rim">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.75 1</ambient>
          <diffuse>0.8 0.8 0.85 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- FRONT-RIGHT STEER + WHEEL -->
    <link name="front_right_steer_link">
      <pose>0.35 -0.225 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
    </link>

    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent><child>front_right_steer_link</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper></limit>
      </axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.35 -0.225 0 -1.5707 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
      </inertial>
      <visual name="tyre">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rim">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.75 1</ambient>
          <diffuse>0.8 0.8 0.85 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!--ACKERMANN STEERING PLUGIN-->
    <plugin filename="libignition-gazebo-ackermann-steering-system.so"
            name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.45</kingpin_width>
      <steering_limit>0.8</steering_limit>
      <wheel_base>0.70</wheel_base>
      <wheel_radius>0.12</wheel_radius>
      <min_velocity>-2</min_velocity>
      <max_velocity>2</max_velocity>
      <min_acceleration>-10</min_acceleration>
      <max_acceleration>10</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
    </plugin>

    <!-- Link 1: physical housing with all visuals, no sensor -->
    <link name="camera_mount">
      <pose>0.1 0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>

      <!-- Orange housing -->
      <visual name="cam_body">
        <geometry><box><size>0.05 0.09 0.05</size></box></geometry>
        <material>
          <ambient>0.85 0.35 0.0 1</ambient>
          <diffuse>1.0  0.45 0.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Dark lens -->
      <visual name="cam_lens">
        <pose>0.026 0 0 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_mount</child>
    </joint>

    <!-- Link 2: empty anchor (same pattern as TurtleBot camera_link) -->
    <link name="camera_link"/>

    <joint name="camera_link_joint" type="fixed">
      <parent>camera_mount</parent>
      <child>camera_link</child>
      <pose>0.1 0 0.35 0 0 0</pose>
    </joint>

    <!-- Link 3: optical frame — sensor lives here
         pose roll=-1.5707 converts from Gazebo (X-fwd, Z-up) to
         ROS camera optical convention (Z-fwd, Y-down).
         pitch=+0.21 rad (~12°) tilts nose down to see road ahead. -->
    <link name="camera_rgb_frame">
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <pose>0 0 0.35 0.0 0.3 0</pose>

      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <ignition_frame_id>camera_rgb_frame</ignition_frame_id>
        <camera name="front_camera">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.004</stddev></noise>
        </camera>
      </sensor>
    </link>

    <joint name="camera_rgb_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_rgb_frame</child>
      <pose>0 0 0.35 -1.5707 0.6 0</pose>
    </joint>

    <!-- JOINT STATE PUBLISHER-->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

  </model>
</sdf>